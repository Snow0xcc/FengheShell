// AI Copilot 抽屉（FengheShell x rssh 缝合）：会话式排障 + 带副作用评级的
// 命令卡片 + LLM 端点设置。刻意只做轻量 Markdown 子集（纯文本 + 代码块），
// 避免把富文本排版引擎塞进一个几十 MB 内存的终端里。

import { Theme } from "theme.slint";
import { LabeledInput } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// 会话列表的一行（标题 / 锚点名 / 状态 / 更新时间 / 是否命中检索）。
export struct ConversationInfo {
    id: string,
    title: string,
    anchor-name: string,
    status: string,        // idle | running | interrupted
    updated: string,       // 已格式化的本地时间
    alive: bool,           // 锚点终端是否还在（锚点丢了会置灰）
    preview: string,       // 检索命中位置附近的一段纯文本（F6）
}

/// 模型 chip 的一项（F2：多份模型配置）。
export struct AiProfileInfo {
    name: string,
    model: string,
    protocol: string,
    is-default: bool,
}

export struct AiMessage {
    role: int,              // 0 用户 / 1 助手 / 2 命令卡片 / 3 错误 / 4 Agent 步骤
    text: string,
    card-id: string,
    cmd: string,
    explain: string,
    side-effect: string,
    risk: string,           // read-only | mutating | destructive
    gate: string,           // direct | fill | blocked
    disposition: string,    // pending | executed | filled | rejected | blocked
    blocked-reason: string,
    step-failed: bool,       // role 4 的步骤是否失败
    step-state: string,      // role 5 的计划步骤状态：pending | running | done | failed
}

component AiCommandCard inherits Rectangle {
    in property <AiMessage> message;
    callback run-card(string);
    callback reject-card(string);
    in-out property <bool> details-open: root.message.disposition == "pending";

    function card-bg(risk: string) -> brush {
        if risk == "destructive" {
            return Theme.danger.with-alpha(0.12);
        }
        if risk == "mutating" {
            return Theme.warning.with-alpha(0.12);
        }
        return Theme.success.with-alpha(0.12);
    }

    function risk-color(risk: string) -> brush {
        if risk == "destructive" {
            return Theme.danger;
        }
        if risk == "mutating" {
            return Theme.warning;
        }
        return Theme.success;
    }

    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.message.step-failed ? Theme.danger : Theme.border-subtle;
    background: root.message.step-failed
        ? Theme.danger.with-alpha(0.08) : root.card-bg(root.message.risk);
    clip: true;

    changed message => {
        root.details-open = root.message.disposition == "pending"
            || root.message.step-failed
            || root.message.text != "";
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: risk-label.width + 10px;
                height: 16px;
                border-radius: 8px;
                background: root.risk-color(root.message.risk);
                risk-label := Text {
                    x: 5px;
                    text: root.message.risk;
                    color: #ffffff;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }
            }
            if root.message.explain != "" : Text {
                horizontal-stretch: 1;
                text: root.message.explain;
                color: Theme.text-secondary;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
                max-lines: 1;
            }
            Text {
                text: root.message.disposition == "pending" ? @tr("Pending") : root.message.disposition;
                color: root.message.step-failed ? Theme.danger
                    : root.message.disposition == "pending" ? Theme.accent
                    : root.message.disposition == "executed · exit 0" ? Theme.success
                    : Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.message.explain == "" : Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: details-ta.has-hover ? Theme.bg-hover : transparent;
                details-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.details-open = !root.details-open; }
                }
                Text {
                    text: root.details-open ? "\u{E5CE}" : "\u{E5CF}";
                    font-family: "Material Icons";
                    font-size: 15px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.details-open : VerticalLayout {
            spacing: 6px;
            if root.message.explain != "" : Text {
                text: root.message.explain;
                wrap: word-wrap;
                color: Theme.text-primary;
                font-size: Theme.fs-sm;
            }
            Text {
                text: root.message.cmd;
                wrap: word-wrap;
                color: Theme.text-primary;
                font-size: Theme.fs-sm;
                font-family: Theme.font-mono;
            }
            if root.message.side-effect != "" : Text {
                text: root.message.side-effect;
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: Theme.fs-xs;
            }
            if root.message.blocked-reason != "" : Text {
                text: root.message.blocked-reason;
                wrap: word-wrap;
                color: Theme.danger;
                font-size: Theme.fs-xs;
            }
            if root.message.text != "" : Rectangle {
                height: min(output.preferred-height + 12px, 120px);
                border-radius: Theme.radius-sm;
                background: Theme.bg-root;
                output := Text {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.message.text;
                    wrap: word-wrap;
                    max-lines: 6;
                    overflow: elide;
                    color: root.message.step-failed ? Theme.danger : Theme.text-secondary;
                    font-size: Theme.fs-xs;
                    font-family: Theme.font-mono;
                }
            }
            if root.message.disposition == "pending" && root.message.gate != "blocked" : HorizontalLayout {
                alignment: end;
                spacing: 6px;
                run-btn := Rectangle {
                    width: run-label.width + 18px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: run-ta.has-hover ? Theme.accent-hover : root.risk-color(root.message.risk);
                    run-ta := TouchArea {
                        clicked => { root.run-card(root.message.card-id); }
                    }
                    run-label := Text {
                        x: 9px;
                        text: root.message.gate == "direct" ? @tr("Run") : @tr("Fill terminal");
                        color: #ffffff;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: reject-label.width + 18px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: reject-ta.has-hover ? Theme.bg-active : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    reject-ta := TouchArea {
                        clicked => { root.reject-card(root.message.card-id); }
                    }
                    reject-label := Text {
                        x: 9px;
                        text: @tr("Reject");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component AiPanel inherits Rectangle {
    in property <[AiMessage]> messages: [];
    in property <bool> busy: false;
    /// 会话列表（Copilot 头部标题点击展开）。
    in property <[ConversationInfo]> conversations: [];
    in-out property <bool> list-open: false;
    /// 当前会话标题与锚点名（空串 = 无终端锚点）。
    in property <string> title: "New conversation";
    in property <string> anchor-name: "";
    /// 面板宽度档位：360 | 520，切换即持久化。
    in property <int> panel-width: 360;
    /// 同时运行的会话上限（满了发送按钮禁用并提示）。
    in property <int> max-parallel: 3;
    /// 模型 chip 的内容与弹出列表（F2）：会话创建时锁定，运行中不可改。
    in property <[AiProfileInfo]> profiles: [];
    /// 当前会话锁定的模型名（空串 = 跟随全局默认）。
    in property <string> model-name: "";
    in-out property <bool> model-list-open: false;
    callback set-model(string);
    /// 会话级记忆开关（F7）。
    in-out property <bool> memory-enabled: true;
    callback set-memory-enabled(bool);
    /// 会话列表检索（F6）：标题 + 消息全文。
    in-out property <string> search: "";
    callback search-changed(string);
    /// 导出当前会话为脱敏 Markdown（F6）。
    callback export-conversation(string);
    callback toggle-list();
    callback new-conversation();
    callback select-conversation(string);
    callback close-conversation(string);
    callback rename-conversation(string, string);
    callback set-width(int);
    /// 工作方式：`ask` | `agent`（对应 GitHub Copilot 的对话层 / 代理层）。
    in-out property <string> mode: "ask";
    /// 补全层开关（Copilot 第一层：命令栏的幽灵文本）。
    in-out property <bool> completion-enabled: true;
    callback set-completion(bool);
    /// 空会话时的起手建议（Copilot 的 starter suggestions）。
    in property <[string]> starters: [];
    in property <string> protocol: "openai-completions";
    in property <string> endpoint: "";
    in property <string> model: "";
    in property <bool> redaction-enabled: true;
    in property <bool> auto-run-readonly: false;
    /// YOLO 模式（完全信任）：开启时抽屉顶部常驻警示横幅。
    in property <bool> yolo-mode: false;

    callback close();
    callback send(string);
    callback set-mode(string);
    callback clear();
    callback cancel();
    // 卡片按钮：绿灯 = 执行；橙灯 = 填入终端。
    callback run-card(string);
    callback reject-card(string);
    callback apply-settings(string, string, string, string, bool, bool);

    property <bool> settings-open: false;
    property <bool> more-open: false;
    property <string> edit-protocol: root.protocol;
    property <string> edit-endpoint: root.endpoint;
    property <string> edit-model: root.model;
    property <string> edit-key: "";
    property <bool> edit-redaction: root.redaction-enabled;
    property <bool> edit-auto: root.auto-run-readonly;
    property <bool> follow-chat: true;

    /// 连通性自检的结果文案；空串表示还没测过。
    in-out property <string> test-status: "";
    in-out property <bool> test-busy: false;
    /// 用当前输入框里的配置试连一次（不落盘）。
    callback test-connection(string, string, string, string);

    background: Theme.bg-panel;
    border-width: 1px;
    border-color: Theme.border-subtle;
    border-radius: Theme.radius-md;
    clip: true;

    changed messages => {
        if (root.follow-chat) {
            chat-scroll.content-y = min(0px, chat-scroll.visible-height - chat-scroll.content-height);
        }
    }

    VerticalLayout {
        spacing: 0;

        // --- 标题栏 --------------------------------------------------------
        // 360px 窄档下只留星标 / 标题 / 更多 / 关闭；新建、宽度、设置、清空
        // 收进「更多」菜单 —— 旧版一排 chip 在 360px 会把标题挤没甚至溢出。
        Rectangle {
            height: 36px;
            background: Theme.bg-panel-alt;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 6px;
                Text {
                    text: "\u{E838}";
                    font-family: "Material Icons";
                    font-size: 16px;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                title-btn := Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    background: title-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: Theme.radius-sm;
                    title-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-list(); root.more-open = false; root.model-list-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 4px;
                        Text {
                            text: root.title;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.list-open ? "\u{E5CE}" : "\u{E5CF}";
                            font-family: "Material Icons";
                            font-size: 14px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
                more-ta := TouchArea {
                    width: 24px;
                    height: parent.height;
                    clicked => { root.more-open = !root.more-open; root.list-open = false; root.model-list-open = false; }
                    Text {
                        text: "\u{E5D4}";
                        font-family: "Material Icons";
                        font-size: 18px;
                        color: more-ta.has-hover || root.more-open ? Theme.accent : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                close-ta := TouchArea {
                    width: 24px;
                    height: parent.height;
                    clicked => { root.close(); }
                    Text {
                        text: "\u{E5CD}";
                        font-family: "Material Icons";
                        font-size: 15px;
                        color: close-ta.has-hover ? Theme.danger : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // --- 次级工具栏：模型 chip + Ask/Agent（窄档也不挤）----------------
        Rectangle {
            height: 30px;
            background: Theme.bg-panel;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 6px;
                model-chip := Rectangle {
                    horizontal-stretch: 1;
                    height: 20px;
                    border-radius: 10px;
                    background: root.model-list-open ? Theme.bg-active : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    model-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.model-list-open = !root.model-list-open; root.list-open = false; root.more-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 2px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.model-name == "" ? @tr("default model") : root.model-name;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.model-list-open ? "\u{E5CE}" : "\u{E5CF}";
                            font-family: "Material Icons";
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }
                ask-chip := Rectangle {
                    width: 44px;
                    height: 20px;
                    border-radius: 10px;
                    background: root.mode != "agent" ? Theme.accent : Theme.bg-elevated;
                    ask-ta := TouchArea { clicked => { root.set-mode("ask"); } }
                    Text {
                        text: "Ask";
                        color: root.mode != "agent" ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                agent-chip := Rectangle {
                    width: 54px;
                    height: 20px;
                    border-radius: 10px;
                    background: root.mode == "agent" ? Theme.accent : Theme.bg-elevated;
                    agent-ta := TouchArea { clicked => { root.set-mode("agent"); } }
                    Text {
                        text: "Agent";
                        color: root.mode == "agent" ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // --- 「更多」菜单：新建 / 宽度 / 设置 / 清空 ------------------------
        if root.more-open : Rectangle {
            height: 126px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: more-new-ta.has-hover ? Theme.bg-hover : transparent;
                    more-new-ta := TouchArea { clicked => { root.new-conversation(); root.more-open = false; } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        Text { text: "\u{E145}"; font-family: "Material Icons"; font-size: 14px; color: Theme.accent; vertical-alignment: center; }
                        Text { text: @tr("New conversation"); color: Theme.text-primary; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: more-width-ta.has-hover ? Theme.bg-hover : transparent;
                    more-width-ta := TouchArea { clicked => { root.set-width(root.panel-width >= 520 ? 360 : 520); root.more-open = false; } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        Text { text: "\u{E8A0}"; font-family: "Material Icons"; font-size: 14px; color: Theme.text-secondary; vertical-alignment: center; }
                        Text { text: @tr("Toggle panel width"); color: Theme.text-primary; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: more-gear-ta.has-hover ? Theme.bg-hover : transparent;
                    more-gear-ta := TouchArea { clicked => { root.settings-open = !root.settings-open; root.more-open = false; } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        Text { text: "\u{E8B8}"; font-family: "Material Icons"; font-size: 14px; color: Theme.text-secondary; vertical-alignment: center; }
                        Text { text: @tr("LLM settings"); color: Theme.text-primary; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: more-clear-ta.has-hover ? Theme.bg-hover : transparent;
                    more-clear-ta := TouchArea { clicked => { root.clear(); root.more-open = false; } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                        Text { text: "\u{E872}"; font-family: "Material Icons"; font-size: 14px; color: Theme.text-secondary; vertical-alignment: center; }
                        Text { text: @tr("Clear conversation"); color: Theme.text-primary; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
            }
        }

        // --- 模型列表 popover（F2）----------------------------------------
        if root.model-list-open : Rectangle {
            height: min(220px, max(64px, root.profiles.length * 28px + 40px));
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for p in root.profiles : Rectangle {
                    height: 26px;
                    background: model-row-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: Theme.radius-sm;
                    model-row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.set-model(p.name); root.model-list-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text {
                            text: (p.name == root.model-name || (root.model-name == "" && p.is-default)) ? "\u{E876}" : "\u{E835}";
                            font-family: "Material Icons";
                            font-size: 13px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: p.name + "  ·  " + p.model;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if p.is-default : Text {
                            text: @tr("default");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.profiles.length == 0 : Rectangle {
                    height: 32px;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: @tr("No model profiles yet - add them in Settings > AI Copilot");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // --- 会话列表 popover（Copilot 头部标题点击展开）-------------------
        // 就地展开（不浮出面板），避免面板窄档时 popover 被裁剪。
        if root.list-open : Rectangle {
            height: min(320px, max(132px, root.conversations.length * 32px + 88px));
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                // 检索框（F6）：标题 + 消息全文，大小写不敏感。
                Rectangle {
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    if root.search == "" : Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: @tr("Search conversations");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    search-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        single-line: true;
                        font-size: Theme.fs-sm;
                        color: Theme.text-primary;
                        text <=> root.search;
                        edited => { root.search-changed(root.search); }
                    }
                }
                for c in root.conversations : Rectangle {
                    height: 30px;
                    background: row-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: Theme.radius-sm;
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-conversation(c.id); root.list-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        spacing: 6px;
                        // 状态点：running 脉冲 / interrupted / idle。
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: c.status == "running" ? Theme.accent
                                : (c.status == "interrupted" ? Theme.warning : Theme.text-muted);
                            opacity: 1;
                            animate opacity {
                                duration: 900ms;
                                iteration-count: -1;
                                direction: alternate;
                            }
                            states [
                                running when c.status == "running" : {
                                    opacity: 0.35;
                                }
                            ]
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            Text {
                                text: c.title;
                                color: c.alive ? Theme.text-primary : Theme.text-muted;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: c.preview != "" ? c.preview
                                    : (c.alive ? c.anchor-name : @tr("no terminal"));
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: c.updated;
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                        // 导出为脱敏 Markdown（F6）。
                        export-row-ta := TouchArea {
                            width: 20px;
                            clicked => { root.export-conversation(c.id); root.list-open = false; }
                            Text {
                                text: "\u{E2C4}";
                                font-family: "Material Icons";
                                font-size: 13px;
                                color: export-row-ta.has-hover ? Theme.accent : Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        close-row-ta := TouchArea {
                            width: 20px;
                            clicked => { root.close-conversation(c.id); }
                            Text {
                                text: "\u{E5CD}";
                                font-family: "Material Icons";
                                font-size: 13px;
                                color: close-row-ta.has-hover ? Theme.danger : Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // 底部「新建会话」。
                new-row-ta := TouchArea {
                    clicked => { root.new-conversation(); root.list-open = false; }
                    new-row := Rectangle {
                        height: 28px;
                        background: new-row-ta.has-hover ? Theme.bg-hover : transparent;
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 4px;
                            Text {
                                text: "\u{E145}";
                                font-family: "Material Icons";
                                font-size: 13px;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                            Text {
                                text: @tr("New conversation");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // --- YOLO 警示横幅（完全信任模式常驻）------------------------------
        if root.yolo-mode : Rectangle {
            height: 28px;
            background: Theme.danger.with-alpha(0.15);
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Text {
                    text: "\u{E002}";
                    font-family: "Material Icons";
                    font-size: 14px;
                    color: Theme.danger;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("YOLO mode: no redaction, no approval");
                    color: Theme.danger;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // --- 设置抽屉 ------------------------------------------------------
        if root.settings-open : Rectangle {
            height: settings-box.preferred-height;
            background: Theme.bg-elevated;
            settings-box := VerticalLayout {
                padding: 10px;
                spacing: 6px;
                LabeledInput {
                    label: @tr("Protocol (openai-completions | deepseek-thinking | anthropic-messages | ollama)");
                    placeholder: "openai-completions";
                    value <=> root.edit-protocol;
                }
                LabeledInput {
                    label: @tr("Endpoint");
                    placeholder: "https://api.openai.com/v1";
                    value <=> root.edit-endpoint;
                }
                LabeledInput {
                    label: @tr("Model");
                    placeholder: "gpt-4o-mini";
                    value <=> root.edit-model;
                }
                LabeledInput {
                    label: @tr("API key (leave blank to keep the stored one)");
                    placeholder: "sk-...";
                    password: true;
                    reveal-enabled: true;
                    value <=> root.edit-key;
                }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        redac-ta := TouchArea {
                            width: redac-row.width;
                            height: redac-row.height;
                            clicked => { root.edit-redaction = !root.edit-redaction; }
                        }
                        redac-row := HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: root.edit-redaction ? "\u{E834}" : "\u{E835}";
                                font-family: "Material Icons";
                                font-size: 15px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                // 补全层总开关（关掉后命令栏不再出现幽灵文本，也不再发请求）。
                Rectangle {
                    comp-ta := TouchArea {
                        width: comp-row.width;
                        height: comp-row.height;
                        clicked => { root.completion-enabled = !root.completion-enabled; root.set-completion(root.completion-enabled); }
                    }
                    comp-row := HorizontalLayout {
                        spacing: 4px;
                        Text { text: root.completion-enabled ? "\u{E834}" : "\u{E835}"; font-family: "Material Icons"; font-size: 15px; color: Theme.text-secondary; vertical-alignment: center; }
                        Text { text: @tr("Command completion"); color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                    }
                }
                            Text {
                                text: @tr("Redact secrets locally");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        auto-ta := TouchArea {
                            width: auto-row.width;
                            height: auto-row.height;
                            clicked => { root.edit-auto = !root.edit-auto; }
                        }
                        auto-row := HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: root.edit-auto ? "\u{E834}" : "\u{E835}";
                                font-family: "Material Icons";
                                font-size: 15px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: @tr("Auto-run read-only commands");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // 会话级记忆注入开关（F7）：关掉后这条会话不再带用户记忆。
                Rectangle {
                    mem-ta := TouchArea {
                        width: mem-row.width;
                        height: mem-row.height;
                        clicked => {
                            root.memory-enabled = !root.memory-enabled;
                            root.set-memory-enabled(root.memory-enabled);
                        }
                    }
                    mem-row := HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.memory-enabled ? "\u{E834}" : "\u{E835}";
                            font-family: "Material Icons";
                            font-size: 15px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("Inject saved memory into this conversation");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    // 连通性自检：用当前输入框里的配置请求一次 /models，
                    // 不落盘、不改动已保存的设置。
                    test-btn := Rectangle {
                        width: 110px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: test-ta.has-hover ? Theme.bg-active : Theme.bg-elevated;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        test-ta := TouchArea {
                            enabled: !root.test-busy;
                            clicked => {
                                root.test-connection(
                                    root.edit-protocol,
                                    root.edit-endpoint,
                                    root.edit-model,
                                    root.edit-key,
                                );
                            }
                        }
                        Text {
                            text: root.test-busy ? @tr("Testing...") : @tr("Test connection");
                            color: root.test-busy ? Theme.text-muted : Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    save-btn := Rectangle {

                        width: 76px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: save-ta.has-hover ? Theme.accent-hover : Theme.accent;
                        save-ta := TouchArea {
                            clicked => {
                                root.apply-settings(
                                    root.edit-protocol,
                                    root.edit-endpoint,
                                    root.edit-model,
                                    root.edit-key,
                                    root.edit-redaction,
                                    root.edit-auto,
                                );
                                root.edit-key = "";
                            }
                        }
                        Text {
                            text: @tr("Save");
                            color: #ffffff;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.test-status != "" : Text {
                    text: root.test-status;
                    wrap: word-wrap;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-xs;
                }
            }
        }

        // --- 对话流 --------------------------------------------------------
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            background: Theme.bg-root;
            chat-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, chat-messages.preferred-height);
                changed content-y => {
                    root.follow-chat = self.content-y
                        >= min(0px, self.visible-height - self.content-height) - 16px;
                }
                chat-messages := VerticalLayout {
                    width: chat-scroll.visible-width;
                    padding: 8px;
                    spacing: 8px;
                    // Pack messages at the top and keep each at its natural height.
                    // Without this the layout stretches rows to fill the viewport
                    // (a one-line question grew into a half-screen tall bubble).
                    alignment: start;
                    // 空会话时的起手建议（Copilot 的 starter suggestions）
                    if root.messages.length == 0 : VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        // 锚点提示：会话绑定哪个终端（没有锚点就明说没有上下文）。
                        Text {
                            text: root.anchor-name == ""
                                ? @tr("No terminal anchor: this conversation runs text-only")
                                : @tr("Anchored to ") + root.anchor-name;
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            wrap: word-wrap;
                        }
                        for s in root.starters : Rectangle {
                            // Fixed-height, full-width pill: avoids relying on a
                            // plain Rectangle's (zero) intrinsic preferred size.
                            height: 40px;
                            width: parent.width;
                            border-radius: Theme.radius-md;
                            background: starter-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            starter-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.send(s); }
                            }
                            starter-row := HorizontalLayout {
                                height: parent.height;
                                padding: 8px;
                                spacing: 6px;
                                Text {
                                    text: "\u{E838}";
                                    font-family: "Material Icons";
                                    font-size: 13px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: s;
                                    wrap: word-wrap;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    for msg in root.messages : VerticalLayout {
                        if msg.role == 2 : AiCommandCard {
                            message: msg;
                            run-card(id) => { root.run-card(id); }
                            reject-card(id) => { root.reject-card(id); }
                        }
                        // 用户气泡（右对齐、带底色）—— Copilot 的提问样式
                        if msg.role == 0 : HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                max-width: parent.width * 0.86;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-elevated;
                                HorizontalLayout {
                                    padding: 8px;
                                    Text {
                                        text: msg.text;
                                        wrap: word-wrap;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-sm;
                                    }
                                }
                            }
                        }
                        // 助手回答：左对齐、无气泡
                        if msg.role == 1 : HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                max-width: parent.width;
                                HorizontalLayout {
                                    padding-left: 2px;
                                    padding-right: 2px;
                                    Text {
                                        text: msg.text;
                                        wrap: word-wrap;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-sm;
                                    }
                                }
                            }
                        }
                        // Agent 的计划清单：复选框 + 步骤文案（Copilot Agent 的 plan 视图）
                        if msg.role == 5 : HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: msg.step-state == "done" ? "\u{E834}"
                                    : msg.step-state == "failed" ? "\u{E837}"
                                    : msg.step-state == "running" ? "\u{E838}"
                                    : "\u{E835}";
                                font-family: "Material Icons";
                                font-size: 14px;
                                color: msg.step-state == "done" ? Theme.success
                                    : msg.step-state == "failed" ? Theme.danger
                                    : msg.step-state == "running" ? Theme.accent
                                    : Theme.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: msg.text;
                                wrap: word-wrap;
                                color: msg.step-state == "pending" ? Theme.text-muted : Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                        }
                        // Agent 的步骤痕迹（工具调用），折叠成一行
                        if msg.role == 4 : HorizontalLayout {
                            alignment: start;
                            spacing: 4px;
                            Text {
                                text: msg.step-failed ? "\u{E000}" : "\u{E5CA}";
                                font-family: "Material Icons";
                                font-size: 12px;
                                color: msg.step-failed ? Theme.danger : Theme.success;
                                vertical-alignment: center;
                            }
                            Text {
                                text: msg.text;
                                wrap: word-wrap;
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                                overflow: elide;
                                max-lines: 2;
                            }
                        }
                        // 错误提示
                        if msg.role == 3 : HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                border-radius: Theme.radius-sm;
                                background: Theme.danger.with-alpha(0.10);
                                HorizontalLayout {
                                    padding: 8px;
                                    Text {
                                        text: msg.text;
                                        wrap: word-wrap;
                                        color: Theme.danger;
                                        font-size: Theme.fs-sm;
                                    }
                                }
                            }
                        }
                    }

                    // 生成中的可见反馈：避免看起来像卡死（停止按钮在输入区，
                    // 但聊天区完全静止会让人以为无响应）。
                    if root.busy : HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            text: "\u{E838}";   // 星标：与 Copilot 入口一致
                            font-family: "Material Icons";
                            font-size: 14px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("Thinking...");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // --- 输入区 --------------------------------------------------------
        Rectangle {
            height: 52px;
            background: Theme.bg-panel-alt;
            HorizontalLayout {
                padding: 7px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.accent : Theme.border-strong;
                    background: Theme.bg-root;
                    if input.text == "" : Text {
                        x: 8px;
                        width: parent.width - 48px;
                        height: parent.height;
                        text: @tr("Ask about this system or session…");
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 6px;
                        input := TextInput {
                            horizontal-stretch: 1;
                            single-line: true;
                            text: "";
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-sm;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            accepted => {
                                if (input.text != "") {
                                    root.send(input.text);
                                    input.text = "";
                                }
                            }
                        }
                        if root.busy : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: stop-ta.has-hover ? Theme.danger : Theme.danger.with-alpha(0.85);
                            stop-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.cancel(); }
                            }
                            Text {
                                text: "\u{E047}";
                                font-family: "Material Icons";
                                font-size: 16px;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if !root.busy : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background: send-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            send-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (input.text != "") {
                                        root.send(input.text);
                                        input.text = "";
                                    }
                                }
                            }
                            Text {
                                text: "\u{E163}";
                                font-family: "Material Icons";
                                font-size: 16px;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
